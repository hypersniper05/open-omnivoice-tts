# Local settings for Docker Compose. The start scripts create .env from this file;
# edit .env, not this file. app/openai_voices.json holds the API settings.

# The GPU: an index as nvidia-smi shows it (0, 1, ...) or a GPU UUID (nvidia-smi -L).
OMNIVOICE_GPU=0

# Port on this computer: the API is at http://localhost:<port>/v1
OMNIVOICE_PORT=8008

# GPU architecture for the FlashInfer kernels: 8.6 = RTX 30, 8.9 = RTX 40, 12.0 = RTX 50.
# The start scripts fill it in from your GPU. After a change, rebuild (start.cmd -Build).
FLASHINFER_CUDA_ARCH_LIST=

# Unload the model after this many idle seconds (0 = keep it loaded).
OMNIVOICE_IDLE_TTL=600

# Cap on the share of GPU memory the model may use (empty = no cap), e.g. 0.55.
OMNIVOICE_MEM_FRACTION=

# Model precision: empty = automatic (float16 on RTX cards, float32 on GTX 16-series and older), or float16 / float32.
OMNIVOICE_DTYPE=

# CPU mode, more than 100 times slower (see README -> Performance): OMNIVOICE_DEVICE=cpu and OMNIVOICE_GPU=-1
OMNIVOICE_DEVICE=cuda:0

# Optional Hugging Face token: faster model downloads and higher rate limits (the model is not gated).
HF_TOKEN=
